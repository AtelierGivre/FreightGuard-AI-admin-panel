# ===========================================
# FreightGuard AI — Environment Variables
# ===========================================
#
# Copy this file to `.env` and adjust values for your machine:
#   cp .env.example .env
#
# SECURITY WARNING:
# - Never commit `.env`. It is ignored by Git.
# - In production, JWT_SECRET MUST be a long random value. The server refuses
#   to start in NODE_ENV=production with the development fallback secret.
# ===========================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Origin of the Next.js app. Used for CORS. Required in production.
CLIENT_URL=http://localhost:3000

# ---------- MongoDB ----------
MONGO_URI=mongodb://127.0.0.1:27017/freightguard

# ---------- JWT ----------
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE=7d

# ---------- Business rules ----------
# Contingency fee charged only on money actually recovered.
DEFAULT_FEE_PCT=25

# ---------- Admin bootstrap (used by seed script) ----------
ADMIN_EMAIL=admin@freightguard.ai
ADMIN_PASSWORD=Admin@12345

# ---------- Client (Next.js public env) ----------
# Required in real mode. Base URL of the Express API. When this is missing,
# the frontend shows a configuration error instead of data.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# TEMPORARY: set to true only while the backend is not connected. In preview
# mode the frontend uses sample data from client/lib/previewData.js (no API or
# MongoDB needed) and offers an "Enter preview as Admin" button. This is NOT
# the final product: once the real API is connected, set this to false in every
# environment (including production) and delete the preview data module and UI
# branches. Preview mode never calls the API; real mode has no silent fallback.
NEXT_PUBLIC_PREVIEW_MODE=false
