# ===========================================
# FreightGuard AI — Environment Variables
# ===========================================
#
# Copy this file to `.env` and adjust values for your machine:
#   cp .env.example .env
#
# SECURITY WARNING:
# - Never commit `.env`. It is ignored by Git.
# - In production, JWT_SECRET MUST be a long random value. The server refuses
#   to start in NODE_ENV=production with the development fallback secret.
# - Never set NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=true in production: it would let
#   failed API calls silently display mock data.
# ===========================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Origin of the Next.js app. Used for CORS. Required in production.
CLIENT_URL=http://localhost:3000

# ---------- MongoDB ----------
MONGO_URI=mongodb://127.0.0.1:27017/freightguard

# ---------- JWT ----------
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE=7d

# ---------- Business rules ----------
# Contingency fee charged only on money actually recovered.
DEFAULT_FEE_PCT=25

# ---------- Admin bootstrap (used by seed script) ----------
ADMIN_EMAIL=admin@freightguard.ai
ADMIN_PASSWORD=Admin@12345

# ---------- Client (Next.js public env) ----------
# Leave this UNSET to run the frontend in demo mode (mock data, no backend).
# Set it to the Express API base URL for live mode.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Local-development only. When true, failed live API calls fall back to demo
# data. Keep false in production and in any environment where numbers matter.
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false
